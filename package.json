{
  "name": "mailforge",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted email platform: transactional API, SMTP relay, campaigns, tracking, bounces, webhooks.",
  "scripts": {
    "build": "tsc && mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/",
    "start:web": "node dist/web/server.js",
    "start:worker": "node dist/worker.js",
    "start:smtp": "node dist/smtp.js",
    "dev:web": "tsx src/web/server.ts",
    "dev:worker": "tsx src/worker.ts",
    "dev:smtp": "tsx src/smtp.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "bullmq": "^5.20.0",
    "csv-parse": "^5.5.6",
    "fastify": "^5.0.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "smtp-server": "^3.13.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
